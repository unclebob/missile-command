{:tasks
 {gherkin-parser
  {:doc "APS gherkin-parser (Babashka tools from Acceptance-Pipeline-Specification)"
   :task (apply shell "gherkin-parser" *command-line-args*)}

  gherkin-mutator
  {:doc "APS gherkin-mutator"
   :task (apply shell "gherkin-mutator" *command-line-args*)}

  gherkin-ir-dry-checker
  {:doc "APS gherkin-ir-dry-checker"
   :task (apply shell {:dir (str (System/getProperty "user.home")
                                 "/.local/share/swarmforge-tools/Acceptance-Pipeline-Specification")}
                "bb" "gherkin-ir-dry-checker" *command-line-args*)}

  check
  {:doc "Validate Speclj structure of unit specs"
   :task (apply shell "clojure" "-M:check" *command-line-args*)}

  test
  {:doc "Run unit tests (Speclj structure check + JVM Speclj)"
   :task (do
           (shell "clojure" "-M:check" "spec")
           (shell "clojure" "-M:test"))}

  spec
  {:doc "Unit specs for clj-mutate workers (self-contained; no deps.edn required)"
   :task (shell "clojure"
                "-Sdeps"
                "{:paths [\"src\" \"spec\"] :deps {org.clojure/clojure {:mvn/version \"1.12.0\"} org.clojure/data.json {:mvn/version \"2.5.1\"} speclj/speclj {:mvn/version \"3.12.2\"}}}"
                "-M" "-m" "speclj.main" "-c")}

  mutate
  {:doc "Language mutation for one source file"
   :task (apply shell "clojure" "-M:mutate" *command-line-args*)}

  accept-mutate
  {:doc "Soft Gherkin acceptance mutation for every feature file"
   :depends [generate-acceptance]
   :task (shell "bash" "-c"
                (str "set -euo pipefail; "
                     "shopt -s nullglob; "
                     "features=(features/*.feature features/*/*.feature); "
                     "if [ ${#features[@]} -eq 0 ]; then echo 'no feature files'; exit 1; fi; "
                     "for f in \"${features[@]}\"; do "
                     "  echo \"===== soft gherkin-mutate $f =====\"; "
                     "  work=\"build/acceptance-mutation/$(basename \"$f\" .feature)\"; "
                     "  gherkin-mutator "
                     "    --runner-worker 'clojure -M:acceptance-mutation-runner' "
                     "    --feature \"$f\" "
                     "    --work-dir \"$work\" "
                     "    --generated-dir acceptance/generated "
                     "    --level soft "
                     "    --status-interval 15s "
                     "    --workers 4; "
                     "done"))}

  crap
  {:doc "CRAP analysis (coverage + complexity) for testable modules"
   :task (apply shell "clojure" "-M:crap"
                (if (seq *command-line-args*)
                  *command-line-args*
                  ;; Host GUI modules open windows; keep CRAP on testable code.
                  ["missile_command/core"
                   "missile_command/world"
                   "missile_command/batteries"
                   "missile_command/missiles"
                   "missile_command/input"
                   "missile_command/cities"
                   "missile_command/entities"
                   "missile_command/waves"
                   "missile_command/scoring"
                   "missile_command/flyers"
                   "missile_command/game_end"
                   "missile_command/screens"
                   "missile_command/hud"
                   "missile_command/high_scores"
                   "missile_command/options"
                   "missile_command/sfx"
                   "missile_command/wave_banner"
                   "missile_command/wave_schedule"
                   "missile_command/wave_lifecycle"
                   "missile_command/bonus_cities"
                   "missile_command/combat"
                   "missile_command/shell"
                   "missile_command/rng"
                   "missile_command/testing"
                   "missile_command/acceptance"
                   "missile_command/jvm/input"]))}

  dry
  {:doc "DRY structural duplication analysis for testable modules"
   :task (apply shell "clojure" "-M:dry"
                (if (seq *command-line-args*)
                  *command-line-args*
                  ["src/missile_command/core.cljc"
                   "src/missile_command/world.cljc"
                   "src/missile_command/batteries.cljc"
                   "src/missile_command/missiles.cljc"
                   "src/missile_command/input.cljc"
                   "src/missile_command/cities.cljc"
                   "src/missile_command/entities.cljc"
                   "src/missile_command/waves.cljc"
                   "src/missile_command/scoring.cljc"
                   "src/missile_command/flyers.cljc"
                   "src/missile_command/game_end.cljc"
                   "src/missile_command/screens.cljc"
                   "src/missile_command/hud.cljc"
                   "src/missile_command/high_scores.cljc"
                   "src/missile_command/options.cljc"
                   "src/missile_command/sfx.cljc"
                   "src/missile_command/wave_banner.cljc"
                   "src/missile_command/wave_schedule.cljc"
                   "src/missile_command/wave_lifecycle.cljc"
                   "src/missile_command/bonus_cities.cljc"
                   "src/missile_command/combat.cljc"
                   "src/missile_command/shell.cljc"
                   "src/missile_command/rng.cljc"
                   "src/missile_command/testing.cljc"
                   "src/missile_command/acceptance"
                   "src/missile_command/jvm/input.clj"]))}

  parse-acceptance
  {:doc "Parse Gherkin features to JSON IR"
   :task (shell "bash" "-c"
                (str "set -euo pipefail; "
                     "mkdir -p build/acceptance/ir; "
                     "rm -f build/acceptance/ir/*.json; "
                     "for f in features/*.feature; do "
                     "  [ -e \"$f\" ] || continue; "
                     "  base=$(basename \"$f\" .feature); "
                     "  gherkin-parser \"$f\" \"build/acceptance/ir/${base}.json\"; "
                     "done; "
                     "for f in features/*/*.feature; do "
                     "  [ -e \"$f\" ] || continue; "
                     "  rel=${f#features/}; "
                     "  rel=${rel%.feature}; "
                     "  ir=$(echo \"$rel\" | tr '/' '-'); "
                     "  gherkin-parser \"$f\" \"build/acceptance/ir/${ir}.json\"; "
                     "done"))}

  generate-acceptance
  {:doc "Generate acceptance test entrypoints from IR"
   :depends [parse-acceptance]
   :task (shell "bash" "-c"
                (str "set -euo pipefail; "
                     "mkdir -p acceptance/generated/metadata; "
                     "rm -f acceptance/generated/*_test.clj; "
                     "rm -f acceptance/generated/metadata/*.json; "
                     "for f in build/acceptance/ir/*.json; do "
                     "  [ -e \"$f\" ] || continue; "
                     "  bin/acceptance-entrypoint-generator \"$f\" acceptance/generated; "
                     "done"))}

  accept
  {:doc "Normal acceptance pipeline: parse → generate → run generated tests"
   :depends [generate-acceptance]
   :task (shell "clojure" "-M:accept")}

  arch-check
  {:doc "Architecture boundary check (pure core vs hosts/IO/acceptance)"
   :task (shell "bb" "script/arch_check.bb")}

  property
  {:doc "Property tests (test.check); separate from unit/coverage"
   :task (shell "clojure" "-X:property")}

  play
  {:doc "Launch the JVM Quil host (mouse aim, key fire)"
   :task (let [args *command-line-args*
               no-keyfocus? (some #{"--no-keyfocus"} args)
               java-tool-options (System/getenv "JAVA_TOOL_OPTIONS")
               qa-awt-options "-Dapple.awt.UIElement=true"
               env (cond-> {}
                     no-keyfocus?
                     (assoc "JAVA_TOOL_OPTIONS"
                            (str (when (seq java-tool-options)
                                   (str java-tool-options " "))
                                 qa-awt-options)))]
           (apply shell (cond-> {}
                          no-keyfocus? (assoc :extra-env env))
                  "clojure" "-M:run" args))}

  browser
  {:doc "Build/serve the ClojureScript browser host (index.html)"
   :task (do
           (shell "mkdir" "-p" "resources/public/js")
           (when-not (.exists (java.io.File. "resources/public/index.html"))
             (println "missing resources/public/index.html"))
           (println "Browser host assets: resources/public/index.html")
           (println "Build with: npx shadow-cljs watch browser")
           (println "Then open: resources/public/index.html (or http://localhost:8020)")
           (if (zero? (:exit (shell {:continue true} "npx" "--yes" "shadow-cljs" "compile" "browser")))
             (println "Compiled to resources/public/js/main.js")
             (println "shadow-cljs compile skipped or failed; index.html still present for open path.")))}}}
